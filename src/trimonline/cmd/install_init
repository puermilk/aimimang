#!/bin/bash
# trimonline 生命周期：安装前检查免责声明、Python 与官方影视依赖。
# 通过后再调用载荷安装脚本；install_callback 会再兜一次，且 pkg_install.sh 本身幂等。
set -u
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SELF_DIR}/_common"

trim_agree_ok || trim_fail "请先阅读并勾选同意《免责声明》后再安装。本插件不含任何影视内容，也不内置任何片源。"

command -v python3 >/dev/null 2>&1 || trim_fail "需要 fnOS 自带的 python3（/usr/bin/python3）。"

if [ ! -S /var/run/trim_media.sock ]; then
    trim_fail "未检测到官方“飞牛影视”（/var/run/trim_media.sock）。请先安装并启动飞牛影视，再安装本插件。"
fi

PAYLOAD="$("${SELF_DIR}/_common" 2>/dev/null || true)"
if [ -n "${PAYLOAD:-}" ] && [ -x "$PAYLOAD/pkg_install.sh" ]; then
    bash "$PAYLOAD/pkg_install.sh" && exit 0
fi
exit 0

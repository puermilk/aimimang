#!/bin/bash
# trimonline 生命周期：文件落盘后完成安装（需要 root）。
# 第二道保险：未同意免责声明则不完成安装（正常已在 install_init 被拦截）。
set -u
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
. "${SELF_DIR}/_common"

trim_agree_ok || trim_fail "未同意《免责声明》，已取消安装。本插件不含任何影视内容，也不内置任何片源。"

PAYLOAD="$("${SELF_DIR}/_common" 2>/dev/null || true)"
if [ -n "${PAYLOAD:-}" ] && [ -x "$PAYLOAD/pkg_install.sh" ]; then
    bash "$PAYLOAD/pkg_install.sh" && exit 0
fi
exit 0

#!/bin/bash
# trimonline 生命周期：就位运行文件并启用接管服务（需要 root）
# 官方不保证 install_callback 一定被调用，cmd/main(start) 会再兜一次，因此必须幂等。
set -u
PAYLOAD="$("$(cd "$(dirname "$0")" && pwd)/_common" 2>/dev/null || true)"
if [ -n "${PAYLOAD:-}" ] && [ -x "$PAYLOAD/pkg_install.sh" ]; then
    bash "$PAYLOAD/pkg_install.sh" && exit 0
fi
exit 0

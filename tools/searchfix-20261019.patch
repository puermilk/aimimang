+async def _refresh_resolve(guid, rec):
+    """播放失败后的强制重解析（带节流，避免同一部片被反复重查）。
+
+    解析失败会被负缓存压住（RESOLVE_NEG_TTL 内不再查）；源侧换地址/换域名
+    之后，老条目的地址也会失效。两种情况下都重解析一次再试。
+    重解析拿不到结果时保留原有 eps（不清空），不会把能放的片子弄坏。"""
+    now = time.time()
+    if now - _FORCE_RESOLVE.get(guid, 0) <= FORCE_RESOLVE_GAP:
+        return rec

+async def _collect_hits(sites, kw, want, min_score, sem):
+    """并发查一组站点，按 want 打分，返回 [(score, site, cand), ...]"""
+    async def one(site):
+        async with sem:
+            try:
+                return site, await cms_query(site, kw)
+            except Exception as e:
+                log("resolve query err:", site.get("name"), repr(e)[:80])
+                return site, []
+    hits = []
+    for site, data in await asyncio.gather(*[one(s) for s in sites]):
+        for cand in data:
+            sc = title_score(want, cand.get("vod_name") or "")
+            if sc < min_score:
+                continue
+            if not (cand.get("vod_play_url") or ""):
+                det = await cms_detail(site, cand.get("vod_id"))
+                if det:
+                    cand = {**cand, **det}
+            if (cand.get("vod_play_url") or ""):
+                hits.append((sc, site, cand))
+    return hits
+
+
+async def _resolve_hits_variants(fast, slow, variants, title, min_score,
+                                  t0, sem):
+    """按标题写法逐级尝试，返回 (hits, 命中的写法)。
+
+    先问「快站」（ffzy 这类 0.5~1s 就返回的）——通常第一两个写法就出结果，
+    不会因为慢站（xingba111 偶尔十几秒）把时间预算耗光；命中后把其余站点
+    用同一个写法补问一遍，凑齐多线路（换源用）。"""
+    hits, hit_var = [], None
+    for v in variants:
+        if time.time() - t0 > RESOLVE_BUDGET:
+            break
+        hits = await _collect_hits(fast, v, title, min_score, sem)
+        if hits:
+            hit_var = v
+            break
+    if slow:
+        if hit_var:                    # 已知正确写法 → 一次问完其余站
+            hits += await _collect_hits(slow, hit_var, title, min_score, sem)
+        else:
+            for v in variants:
+                if time.time() - t0 > RESOLVE_BUDGET:
+                    break
+                h = await _collect_hits(slow, v, title, min_score, sem)
+                if h:
+                    hits, hit_var = h, v
+                    break
+    return hits, hit_var
+

+def title_variants(title):
+    """采集站的搜索是「字面包含」匹配，标题里的空格/季数/副标题常导致查不到：
+    『凡人修仙传 年番4』两个字面都查不到，『凡人修仙传』就能查到。
+    给出从精确到宽松的几种写法（去重保序），供解析时逐个尝试。"""
+    t = (title or "").strip()
+    out = []
+
+    def add(x):
+        x = (x or "").strip()
+        if x and x not in out:
+            out.append(x)
+
+    add(t)
+    nospace = re.sub(r"\s+", "", t)
+    add(nospace)
+    add(_SEASON_SUFFIX.split(nospace)[0])              # 去「第四季/年番4」等后缀
+    for sep in (" ", "　", "：", ":", "-", "—", "·"):
+        if sep in t:
+            add(re.sub(r"\s+", "", t.split(sep)[0]))   # 取主标题
+    return out
+
